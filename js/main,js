const ball = document.querySelector("#ball");


let y = -150;
let speed = 0;

const gravity = 0.8;

const ground = window.innerHeight - 150;

let bounceCount = 0;


function animate(){

    speed += gravity;
    y += speed;


    if(y >= ground){

        y = ground;

        speed *= -0.55;

        bounceCount++;

        console.log("bounce", bounceCount);


        if(bounceCount >= 5){

            speed = 0;

        }

    }


    ball.style.top = y + "px";


    requestAnimationFrame(animate);

}


animate();
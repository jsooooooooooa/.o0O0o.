const ball = document.querySelector("#ball");


// 시작 위치
let position = -100;
let velocity = 0;

const gravity = 0.8;

const floor = window.innerHeight / 2 + 250;

let bounce = 0;


function animate(){

    velocity += gravity;

    position += velocity;


    // 바닥 충돌

    if(position >= floor){

        position = floor;

        velocity *= -0.55;

        bounce++;

        console.log("bounce", bounce);


        // 작은 튐은 종료

        if(bounce >= 5){

            velocity = 0;

        }

    }


    ball.style.transform =
    `translate(-50%, ${position}px)`;


    requestAnimationFrame(animate);

}


animate();